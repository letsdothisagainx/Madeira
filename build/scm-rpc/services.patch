+/* A service may legitimately exit while handing work to its own updater.
+ * Record the actual wait outcome without treating it as service readiness. */
+static void trace_service_pipe_wait( DWORD wait, ULONGLONG begin, BOOL connected, DWORD error )
+{
+    static LONG traces;
+    const char *outcome = wait == WAIT_OBJECT_0 ? "event" :
+                          wait == WAIT_OBJECT_0 + 1 ? "process-exit" :
+                          wait == WAIT_TIMEOUT ? "timeout" : "wait-error";
+    if (InterlockedIncrement( &traces ) <= 32)
+        WINE_ERR( "[scm-pipe-wait-v1] outcome=%s wait=%lu elapsed-ms=%llu timeout-ms=%lu overlapped=%lu error=%lu\n",
+                 outcome, (unsigned long)wait, (unsigned long long)(GetTickCount64() - begin),
+                 (unsigned long)service_pipe_timeout, (unsigned long)connected, (unsigned long)error );
+}
