+/* ServicesPipeTimeout is a DWORD on Windows. Keep the historical Wine
+ * decimal-string form, but ignore malformed, zero and infinite values. */
+static BOOL parse_service_pipe_timeout( DWORD type, const void *data, DWORD count, DWORD *value )
+{
+    DWORD parsed = 0, i, first, length;
+    const WCHAR *text = data;
+    if (!data || !value) return FALSE;
+    if (type == REG_DWORD)
+    {
+        if (count != sizeof(parsed)) return FALSE;
+        memcpy( &parsed, data, sizeof(parsed) );
+    }
+    else if (type == REG_SZ)
+    {
+        if (count < sizeof(WCHAR) || count % sizeof(WCHAR)) return FALSE;
+        length = count / sizeof(WCHAR);
+        if (text[length - 1]) return FALSE;
+        for (i = 0; i < length - 1 && (text[i] == ' ' || text[i] == '\t' ||
+                                     text[i] == '\r' || text[i] == '\n'); i++) {}
+        if (text[i] == '+') i++;
+        first = i;
+        for (; i < length - 1 && text[i] >= '0' && text[i] <= '9'; i++)
+        {
+            DWORD digit = text[i] - '0';
+            if (parsed > (MAXDWORD - digit) / 10) return FALSE;
+            parsed = parsed * 10 + digit;
+        }
+        if (first == i) return FALSE;
+        while (i < length - 1 && (text[i] == ' ' || text[i] == '\t' ||
+                                 text[i] == '\r' || text[i] == '\n')) i++;
+        if (i != length - 1) return FALSE;
+    }
+    else return FALSE;
+    if (!parsed || parsed == INFINITE) return FALSE;
+    *value = parsed;
+    return TRUE;
+}
