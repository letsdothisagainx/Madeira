+#ifdef __arm64ec__
+#include "madeira_scm_aux_slot.h"
+
+/* Bind the native auxiliary slot as well as the public IAT. An EC varargs
+ * call cannot safely take the lazy EC->x64->EC detour: the exit thunk spills
+ * the x4/x5 argument-window descriptor as x64 arguments. Keep this repair
+ * limited to the verified SCM producer/import, without changing x64 exports,
+ * the global EC classifier, FEX state or generic NDR argument slots. */
+static BOOL arm64ec_bind_scm_rpc_aux( WINE_MODREF *wm, IMAGE_THUNK_DATA *slot )
+{
+    HMODULE module = wm->ldr.DllBase;
+    const IMAGE_ARM64EC_METADATA *metadata = arm64ec_get_module_metadata( module );
+    const IMAGE_NT_HEADERS *nt = RtlImageNtHeader( module );
+    const IMAGE_DATA_DIRECTORY *iat;
+    ULONG_PTR *aux;
+    struct ios_sync_pe_write_params params;
+    NTSTATUS sync;
+    PVOID protect_base;
+    SIZE_T protect_size = sizeof(*aux);
+    DWORD protect_old, ignored;
+    uint32_t aux_rva;
+    static unsigned int reports;
+
+    if (!metadata || !nt || !RtlIsEcCode( slot->u1.Function )) return FALSE;
+    iat = &nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IAT];
+    if (!madeira_scm_aux_slot( nt->OptionalHeader.SizeOfImage, iat->VirtualAddress,
+                              iat->Size, (char *)slot - (char *)module,
+                              metadata->AuxiliaryIAT, &aux_rva )) return FALSE;
+    aux = get_rva( module, aux_rva );
+    protect_base = aux;
+    if (NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                                PAGE_READWRITE, &protect_old )) return FALSE;
+    *aux = slot->u1.Function;
+    /* AuxiliaryIAT is read-only .rdata in the execution view. Sync through
+     * the existing owner-aware Unix helper and its writable JIT alias;
+     * never store through the RX translation or rely on fault emulation. */
+    params.address = aux;
+    params.size = sizeof(*aux);
+    params.synced = 0;
+    sync = WINE_UNIX_CALL( unix_ios_sync_pe_write, &params );
+    if (NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                                protect_old, &ignored )) return FALSE;
+    if (sync) return FALSE;
+    if (reports++ < 8)
+        ERR( "[scm-rpc-bind] native=1 auxiliary=1 pool=%u\n", (unsigned int)params.synced );
+    return TRUE;
+}
+#endif
