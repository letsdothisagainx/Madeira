--- a/dlls/crypt32/chain.c
+++ b/dlls/crypt32/chain.c
@@ -3070,6 +3070,22 @@
         find_element_with_error(pChainContext,
          CERT_TRUST_HAS_NOT_SUPPORTED_CRITICAL_EXT, &pPolicyStatus->lChainIndex,
          &pPolicyStatus->lElementIndex);
+    }
+    /* Review candidate: preserve every existing error and caller waiver.
+     * PARTIAL_CHAIN belongs to a simple chain, not a certificate element. */
+    if (!pPolicyStatus->dwError &&
+        (pChainContext->TrustStatus.dwErrorStatus & CERT_TRUST_IS_PARTIAL_CHAIN) &&
+        !(checks & CERT_CHAIN_POLICY_ALLOW_UNKNOWN_CA_FLAG))
+    {
+        DWORD i;
+
+        pPolicyStatus->dwError = CERT_E_CHAINING;
+        for (i = 0; i < pChainContext->cChain; i++)
+            if (pChainContext->rgpChain[i]->TrustStatus.dwErrorStatus & CERT_TRUST_IS_PARTIAL_CHAIN)
+            {
+                pPolicyStatus->lChainIndex = i;
+                break;
+            }
     }
     return TRUE;
 }
