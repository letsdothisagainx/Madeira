+# The private callback publishes subfloor state before CRT/guest startup.
+# Use the same host tune as FEXCore so these atomic CAS operations lower to
+# supported LSE CAS, rather than an unhandled LL/SC sequence writing PE RX data.
+# The build verifies the actual resulting object before packaging.
+if (FEX_IOS_HOST_BUILD)
+  set_property(SOURCE IosJitAlias.cpp APPEND PROPERTY COMPILE_OPTIONS ${FEX_TUNE_COMPILE_FLAGS})
+endif()
