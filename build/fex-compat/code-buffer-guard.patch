+// Only native CodeBuffer allocations opt into permanent guarded classes.
+// A missing/old consumer must fail; falling back to an unguarded allocation
+// would manufacture the guarantee the caller uses for its usable bound.
+inline void* VirtualAllocCodeBuffer(size_t Size, size_t GuardBytes) {
+#if defined(FEX_IOS_HOST) && defined(_WIN32)
+  if (GuardBytes == FEXCore::Utils::FEX_PAGE_SIZE) return VirtualAlloc(Size, true);
+  if (GuardBytes != MADEIRA_FEX_CODE_GUARD_BYTES || !madeira_fex_code_buffer_class_valid(Size)) return nullptr;
+  MEM_EXTENDED_PARAMETER Parameters[2] {};
+  Parameters[0].Type = MemExtendedParameterAttributeFlags;
+  Parameters[0].ULong64 = MEM_EXTENDED_PARAMETER_EC_CODE;
+  Parameters[1].Type = MADEIRA_FEX_CODE_PARAMETER_TYPE;
+  Parameters[1].ULong64 = MADEIRA_FEX_CODE_GUARD_ABI_V1;
+  return ::VirtualAlloc2(nullptr, nullptr, Size, MEM_COMMIT | MEM_RESERVE,
+                         PAGE_EXECUTE_READWRITE, Parameters, 2);
+#else
+  (void)GuardBytes;
+  return VirtualAlloc(Size, true);
+#endif
+}
 
