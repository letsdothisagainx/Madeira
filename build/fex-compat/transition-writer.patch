+// The private writer selects the SAME physical IosXpFex bytes. Acquire keeps
+// the descriptor publication contract; CBNZ and the address loads preserve NZCV.
+// A NULL writer retains canonical-address recovery when the ABI is unavailable.
+.macro IOS_XP_WRITER reg
+  adrp \reg, MadeiraFEXTransitionWriteContract
+  add \reg, \reg, #:lo12:MadeiraFEXTransitionWriteContract
+  add \reg, \reg, #24
+  ldar \reg, [\reg]
+  cbnz \reg, .Lmadeira_xp_ready\@
+  adrp \reg, IosXpFex
+  add \reg, \reg, #:lo12:IosXpFex
+.Lmadeira_xp_ready\@:
+.endm
