 GuestToHostMap::GuestToHostMap()
   : BlockLinks_mbr {"FEXMem_BlockLinks"} {
+#if defined(FEX_IOS_HOST) && defined(_WIN32) && !defined(ARCHITECTURE_arm64ec)
+  static std::atomic<unsigned> Reports {};
+  if (Reports.fetch_add(1, std::memory_order_relaxed) < 16)
+    LogMan::Msg::EFmt("[fex-blocklist-v1] entrypoint map uses bounded value/bucket segments; existing allocator and locks retained");
+#endif
   BlockLinks_pma = fextl::make_unique<std::pmr::polymorphic_allocator<std::byte>>(&BlockLinks_mbr);
