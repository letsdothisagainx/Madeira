+#if defined(FEX_IOS_HOST) && defined(_WIN32) && !defined(ARCHITECTURE_arm64ec)
+  // Each value is 40 bytes on this target. The contiguous map doubles its
+  // value vector from 20 to 40 MiB at 524289 entrypoints, requiring both
+  // buffers to coexist. A fragmented native arena can have hundreds of MiB
+  // free while no such contiguous allocation fits. The library's segmented
+  // map keeps the same hashing/allocator/API, with bounded value AND bucket
+  // segments. All map access and publication retain the existing locks.
+  using BlockListType = ankerl::unordered_dense::segmented_map<
+    uint64_t, BlockEntry, std::hash<uint64_t>, std::equal_to<uint64_t>,
+    fextl::FEXAlloc<std::pair<uint64_t, BlockEntry>>>;
+  BlockListType BlockList;
+#else
   fextl::robin_map<uint64_t, BlockEntry> BlockList;
+#endif
 
   fextl::map<uint64_t, fextl::vector<uint64_t>> CodePages;
 
