+#ifdef FEX_IOS_HOST
+// Called only by the native terminal tail on THIS Wine thread, while its
+// lease still counts it as live. Foreign-thread requests never free state.
+extern "C" __declspec(dllexport) uint32_t MadeiraBTCpuIosRetireThread(
+    void* TebPtr, uint64_t* OutState, uint32_t* OutDepth, uint32_t* OutFlags) {
+  if (OutState) *OutState = 0;
+  if (OutDepth) *OutDepth = 0;
+  if (OutFlags) *OutFlags = 0;
+  if (!TebPtr) return MADEIRA_FEX_HOLD_RELEASE_SELFTEST;
+  auto* Teb = CurrentTEB();
+  if (TebPtr != Teb) return MADEIRA_FEX_HOLD_RELEASE_FOREIGN_THREAD;
+  if (!MadeiraContextOwnerPEB || reinterpret_cast<__TEB*>(Teb)->Peb != MadeiraContextOwnerPEB)
+    return MADEIRA_FEX_HOLD_RELEASE_FOREIGN_PROCESS;
+  if (!CTX) return MADEIRA_FEX_HOLD_RELEASE_NO_CONTEXT;
+  const auto TLS = ::TLS {Teb};
+  auto* Thread = TLS.ThreadStateIfInitialised();
+  if (!Thread) { FEX::Windows::DeinitCRTThread(); return 0; }
+  if (Thread->CTX != CTX.get()) return MADEIRA_FEX_HOLD_RELEASE_NO_CONTEXT;
+  if (OutState) *OutState = reinterpret_cast<uint64_t>(Thread);
+  const auto Released = MadeiraBTCpuIosReleaseThreadHolds(Teb,nullptr,nullptr,nullptr);
+  const auto Depth = *reinterpret_cast<volatile uint32_t*>(reinterpret_cast<uintptr_t>(Teb)+0x16f0);
+  const auto Stamp = *reinterpret_cast<volatile uint64_t*>(reinterpret_cast<uintptr_t>(Teb)+0x16f8);
+  const auto Emit = *reinterpret_cast<volatile uint64_t*>(reinterpret_cast<uintptr_t>(Teb)+0x16e8);
+  if (OutDepth) *OutDepth = Depth;
+  if (Depth || Stamp || Emit || (Released && Released != MADEIRA_FEX_HOLD_RELEASE_SHARED))
+    return MADEIRA_FEX_THREAD_RETIRE_REFUSED;
+  // A killed compile may have abandoned a private mutex. Never block the
+  // whole pseudo-process or unlock a mutex we cannot prove belongs to us.
+  if (!MadeiraRetireThread(TLS,GetCurrentThreadId(),true,true)) return MADEIRA_FEX_THREAD_RETIRE_BUSY;
+  static std::atomic<unsigned> Reports {};
+  if (Reports.fetch_add(1,std::memory_order_relaxed) < 64)
+    IosRawReport("E [fex-thread-retire-v1] tid={:#x} teb={} state={} callret=freed lookup=freed crt=queued-for-reuse",
+                 GetCurrentThreadId(),static_cast<void*>(Teb),reinterpret_cast<void*>(Thread));
+  return MADEIRA_FEX_THREAD_RETIRED;
+}
