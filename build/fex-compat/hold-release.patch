+/* Native ARM64 only. Called by this same dying Wine thread, or at the
+ * no-return allocation-failure boundary. Never release a suspended foreign
+ * thread's locks or release locks before a resumable exception dispatch. */
+extern "C" __declspec(dllexport) uint32_t MadeiraBTCpuIosReleaseThreadHolds(
+    void* TebPtr, uint64_t* OutStamp, uint32_t* OutDepth, uint32_t* OutFlags) {
+  if (OutStamp) *OutStamp = 0;
+  if (OutDepth) *OutDepth = 0;
+  if (OutFlags) *OutFlags = 0;
+  if (!TebPtr) return MADEIRA_FEX_HOLD_RELEASE_SELFTEST;
+  auto* Teb = CurrentTEB();
+  if (TebPtr != Teb) return MADEIRA_FEX_HOLD_RELEASE_FOREIGN_THREAD;
+  if (!MadeiraContextOwnerPEB || reinterpret_cast<__TEB*>(Teb)->Peb != MadeiraContextOwnerPEB)
+    return MADEIRA_FEX_HOLD_RELEASE_FOREIGN_PROCESS;
+  if (!CTX) return MADEIRA_FEX_HOLD_RELEASE_NO_CONTEXT;
+  auto* Thread = TLS {Teb}.ThreadStateIfInitialised();
+  if (!Thread || Thread->CTX != CTX.get()) return MADEIRA_FEX_HOLD_RELEASE_NO_CONTEXT;
+  auto* Depth = reinterpret_cast<volatile uint32_t*>(reinterpret_cast<uintptr_t>(Teb) + 0x16f0);
+  auto* Stamp = reinterpret_cast<volatile uint64_t*>(reinterpret_cast<uintptr_t>(Teb) + 0x16f8);
+  const auto DepthVal = *Depth;
+  const auto StampVal = *Stamp;
+  if (OutStamp) *OutStamp = StampVal;
+  if (OutDepth) *OutDepth = DepthVal;
+  const bool Exclusive = Thread->FrontendPtr && GetFrontendThreadData(Thread)->InLockedRWXRead;
+  if (OutFlags) *OutFlags = Exclusive ? 1u : 0u;
+  // ReadFile's exclusive pair needs its own After path; it is not a shared
+  // hold and this callback must not guess how to unlock it.
+  if (Exclusive) return MADEIRA_FEX_HOLD_RELEASE_INVALID_DEPTH;
+  if (!StampVal && !DepthVal) return 0;
+  auto& Mutex = CTX->GetCodeInvalidationMutex();
+  if (StampVal != Mutex.IosStampAddress()) return MADEIRA_FEX_HOLD_RELEASE_FOREIGN_STAMP;
+  // TEB depth aggregates all WPM locks. For nested holds require a complete
+  // matching record in THIS mutex's existing ring; missing/mixed records
+  // fail closed, including depth one with a stale stamp or missing record.
+  if (!DepthVal || DepthVal > 16 || Mutex.MadeiraSharedHoldsForTEB(reinterpret_cast<uint64_t>(Teb)) != DepthVal)
+    return MADEIRA_FEX_HOLD_RELEASE_INVALID_DEPTH;
+  for (uint32_t i = 0; i < DepthVal; i++) Mutex.unlock_shared();
+  return MADEIRA_FEX_HOLD_RELEASE_SHARED;
+}
+
+static void MadeiraReleaseOwnThreadHolds(const char* Stage) {
+  uint64_t Stamp = 0;
+  uint32_t Depth = 0, Flags = 0;
+  const auto Result = MadeiraBTCpuIosReleaseThreadHolds(CurrentTEB(), &Stamp, &Depth, &Flags);
+  static std::atomic<unsigned> Reports {};
+  if ((Stamp || Depth || Flags) && Reports.fetch_add(1, std::memory_order_relaxed) < 32)
+    IosRawReport("E [fex-hold-release-v1] stage={} result={:#x} stamp={:#x} depth={} flags={:#x} self=1",
+                 Stage, Result, Stamp, Depth, Flags);
+}
+
+extern "C" void MadeiraFEXReleaseCurrentThreadHoldsForFatalAllocation() {
+  // ReportAllocationFailure cannot return into the interrupted C++ scopes.
+  // Releasing here keeps the original fatal assertion and avoids leaving a
+  // dead reader when Wine subsequently ends this process's native threads.
+  MadeiraReleaseOwnThreadHolds("fatal-allocation");
+}
+
+static void MadeiraRegisterOwnHoldRelease() {
+  void* Alias = nullptr;
+  auto Status = NtQueryVirtualMemory(GetCurrentProcess(), reinterpret_cast<void*>(&MadeiraBTCpuIosReleaseThreadHolds),
+      static_cast<MEMORY_INFORMATION_CLASS>(MADEIRA_FEX_JIT_POOL_ADDRESS_CLASS), &Alias, sizeof(Alias), nullptr);
+  if (!Status && Alias) {
+    using Callback = uint32_t (*)(void*, uint64_t*, uint32_t*, uint32_t*);
+    if (reinterpret_cast<Callback>(Alias)(nullptr, nullptr, nullptr, nullptr) != MADEIRA_FEX_HOLD_RELEASE_SELFTEST)
+      Status = STATUS_INVALID_PARAMETER;
+    else {
+      const madeira_fex_hold_registration Registration {sizeof(madeira_fex_hold_registration),
+          MADEIRA_FEX_HOLD_REGISTER_VERSION, MadeiraContextOwnerPEB, Alias};
+      Status = NtSetInformationProcess(GetCurrentProcess(), static_cast<PROCESSINFOCLASS>(MADEIRA_FEX_HOLD_REGISTER_CLASS),
+          const_cast<madeira_fex_hold_registration*>(&Registration), sizeof(Registration));
+    }
+  } else if (!Status) Status = STATUS_INVALID_PARAMETER;
+  IosRawReport("E [fex-hold-release-v1] register-native-wow owner={} callback={} status={:#x}",
+               MadeiraContextOwnerPEB, Alias, static_cast<uint32_t>(Status));
+}
+#endif
