# Passed through CMAKE_PROJECT_FEX_INCLUDE (or CMAKE_PROJECT_INCLUDE). The
# deferred mutation runs after FEX has created its allocator targets.
if(NOT PROJECT_NAME STREQUAL "FEX" OR NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  return()
endif()
if(NOT WIN32 OR NOT FEX_IOS_HOST_BUILD OR (DEFINED ENABLE_FEX_ALLOCATOR AND NOT ENABLE_FEX_ALLOCATOR))
  return()
endif()
if(CMAKE_VERSION VERSION_LESS 3.19)
  message(FATAL_ERROR "Madeira's FEX owner allocator requires CMake 3.19 or newer")
endif()
# The source overlay includes an owned, source-built private writer contract.
# Do not copy or modify this helper in the vendor tree. Its path also becomes
# an ordinary compiler dependency for both native PE backends.
add_compile_definitions(MADEIRA_FEX_NATIVE_DIAGNOSTICS_HEADER="${CMAKE_CURRENT_LIST_DIR}/native_diagnostics.h")
add_compile_definitions(MADEIRA_FEX_CODE_BUFFER_ABI_HEADER="${CMAKE_CURRENT_LIST_DIR}/../ntdll-unix/fex_code_buffer_abi.h")
set_property(GLOBAL PROPERTY MADEIRA_FEX_OWNER_ALLOCATOR_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(madeira_fex_owner_allocator)
  if(NOT WIN32 OR NOT FEX_IOS_HOST_BUILD OR NOT ENABLE_FEX_ALLOCATOR)
    return()
  endif()
  get_property(compat_dir GLOBAL PROPERTY MADEIRA_FEX_OWNER_ALLOCATOR_DIR)
  if(NOT TARGET JemallocLibs OR NOT TARGET rpmalloc)
    message(FATAL_ERROR "FEX allocator targets are missing")
  endif()
  set(original "${CMAKE_SOURCE_DIR}/External/rpmalloc/rpmalloc/rpmalloc.c")
  set(allocator_header "${CMAKE_SOURCE_DIR}/External/rpmalloc/rpmalloc/rpmalloc.h")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${allocator_header}" "${compat_dir}/owner_allocator.cpp" "${compat_dir}/owner_allocator.h" "${compat_dir}/owner_allocator_backoff.h")
  file(SHA256 "${original}" source_hash)
  if(NOT source_hash STREQUAL "d810c3695daab1c74e92ba971f1f068b44b3d6172e0a69c5a0c6f8a07234f96b")
    message(FATAL_ERROR "Pinned rpmalloc input changed; review the two allocation-failure guards")
  endif()
  file(SHA256 "${allocator_header}" header_hash)
  if(NOT header_hash STREQUAL "81c4970f89951c177cd83f29ec7c1989e14c31f3bb5e2eda4a2b84e1dd338fb6")
    message(FATAL_ERROR "Pinned rpmalloc API changed; review the explicit heap boundary")
  endif()
  file(READ "${original}" checked)
  set(before "block_t* block = global_memory_interface->memory_map(heap_size, 0, &offset, &mapped_size);\n#if ENABLE_DECOMMIT")
  set(after "block_t* block = global_memory_interface->memory_map(heap_size, 0, &offset, &mapped_size);\n\tif (!block)\n\t\treturn 0;\n#if ENABLE_DECOMMIT")
  string(FIND "${checked}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "rpmalloc heap metadata failure boundary changed")
  endif()
  string(REPLACE "${before}" "${after}" checked "${checked}")
  set(before "void fex_ios_rpm_lock(void) {\n\tuintptr_t self, expected = 0;")
  set(after "#include \"owner_allocator_backoff.h\"\nvoid fex_ios_rpm_lock(void) {\n\tuintptr_t self;\n\tunsigned madeira_contended_polls = 0;")
  string(FIND "${checked}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "rpmalloc recursive owner lock boundary changed")
  endif()
  string(REPLACE "${before}" "${after}" checked "${checked}")
  set(before "\twhile (!atomic_compare_exchange_weak_explicit(&fex_ios_rpm_owner, &expected, self, memory_order_acquire,\n\t                                              memory_order_relaxed)) {\n\t\texpected = 0;\n\t\twait_spin();\n\t}\n\tfex_ios_rpm_depth = 1;")
  set(after "\twhile (!madeira_fex_rpm_try_owner(self)) {\n\t\tif (++madeira_contended_polls == 64) {\n\t\t\tmadeira_contended_polls = 0;\n\t\t\tmadeira_fex_rpm_backoff();\n\t\t} else {\n\t\t\twait_spin();\n\t\t}\n\t}\n\tmadeira_fex_rpm_publish_depth();")
  string(FIND "${checked}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "rpmalloc contended owner lock retry changed")
  endif()
  string(REPLACE "${before}" "${after}" checked "${checked}")
  set(before "heap_t* heap = heap_allocate(1);\n\trpmalloc_assume(heap != 0);")
  set(after "heap_t* heap = heap_allocate(1);\n\tif (!heap)\n\t\treturn 0;\n\trpmalloc_assume(heap != 0);")
  string(FIND "${checked}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "rpmalloc explicit heap failure boundary changed")
  endif()
  string(REPLACE "${before}" "${after}" checked "${checked}")
  set(copy_dir "${CMAKE_BINARY_DIR}/madeira-fex-compat")
  file(MAKE_DIRECTORY "${copy_dir}")
  # configure_file avoids changing the source timestamp on every configure.
  file(WRITE "${copy_dir}/rpmalloc-checked.c.in" "${checked}")
  configure_file("${copy_dir}/rpmalloc-checked.c.in" "${copy_dir}/rpmalloc-checked.c" COPYONLY)
  set_property(TARGET rpmalloc PROPERTY SOURCES "${copy_dir}/rpmalloc-checked.c")
  target_include_directories(rpmalloc PRIVATE "${CMAKE_SOURCE_DIR}/External/rpmalloc/rpmalloc" "${compat_dir}")
  target_compile_definitions(rpmalloc PRIVATE RPMALLOC_FIRST_CLASS_HEAPS=1)
  set_property(TARGET JemallocLibs PROPERTY SOURCES "${compat_dir}/owner_allocator.cpp")
  target_compile_definitions(JemallocLibs PRIVATE RPMALLOC_FIRST_CLASS_HEAPS=1)
  message(STATUS "Madeira FEX allocation: image-private serialized explicit heap; original span geometry")
endfunction()

cmake_language(DEFER CALL madeira_fex_owner_allocator)
