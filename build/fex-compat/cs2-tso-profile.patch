+#ifdef FEX_IOS_HOST
+/* Process-local candidate: preserve unrelated overrides and TSO ordering.
+ * This runs after LoadConfig/ReloadMetaLayer, before FetchHostFeatures and
+ * creation of a fresh CTX. Never mutate the host or inherited environment. */
+static bool MadeiraConfigureCS2TSO(const fextl::string& ExecutableName) {
+  if (_stricmp(ExecutableName.c_str(), "cs2.exe") != 0) {
+    return false;
+  }
+  FEX_CONFIG_OPT(PreviousFeatures, HOSTFEATURES);
+  const uint64_t Before = PreviousFeatures();
+  const uint64_t After = (Before & ~uint64_t(FEXCore::Config::HostFeatures::ENABLELRCPC2)) |
+                         uint64_t(FEXCore::Config::HostFeatures::DISABLELRCPC2);
+  FEXCore::Config::Set(FEXCore::Config::CONFIG_HOSTFEATURES, fextl::fmt::format("{}", After));
+  // Do not import a translation produced under different effective features.
+  // The existing Windows cache loader has no feature-qualified cache key.
+  // Keep all files intact; the new context's lookups start empty as usual.
+  FEXCore::Config::Set(FEXCore::Config::CONFIG_ENABLECODECACHINGWIP, "0");
+  return true;
+}
+#endif
